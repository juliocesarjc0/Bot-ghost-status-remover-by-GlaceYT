# Discord Bot Configuration
# Get your bot token from: https://discord.com/developers/applications
TOKEN=your_discord_bot_token_here

# Status Messages (comma-separated)
# These messages will rotate as the bot's status
STATUS_MESSAGES=PLAYING,MUSIC,ONLINE,VIBING

# Status Type (Custom, Playing, Watching, Listening, Streaming, Competing)
STATUS_TYPE=Custom

# Status State (online, idle, dnd, invisible)
STATUS_STATE=dnd

# Update Interval (in milliseconds)
# Default: 10000 (10 seconds)
UPDATE_INTERVAL=10000

# Optional: Channel ID to send status update messages
# Leave empty to disable channel messages
CHANNEL_ID=

# Server Configuration
PORT=3000
HOST=localhost

# Application Configuration
APP_NAME=Discord Status Bot
NODE_ENV=production
